# Free tier keys — get these from:
# https://newsapi.org/register
NEWSAPI_KEY=
# https://gnews.io/register
GNEWS_KEY=
# https://www.marketaux.com/register (optional fallback)
MARKETAUX_KEY=

# FinBERT sentiment via Hugging Face's free hosted Inference API.
# https://huggingface.co/settings/tokens (free account, "Read" scope is enough)
# If left blank, sentiment falls back to a simple keyword lexicon so the
# app still runs, but it will NOT be real FinBERT output.
HF_API_TOKEN=

DB_PATH=finagent_india.db
